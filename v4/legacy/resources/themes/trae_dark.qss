/* ═══════════════════════════════════════════════════════
   Trae Dark Theme — AI Agent Workbench
   Inspired by Trae IDE design language
   ═══════════════════════════════════════════════════════ */

/* ——— 全局 —————————————————————————————————————————— */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMainWindow { background-color: #1e1e2e; }

QToolTip {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

/* ——— Sidebar ——————————————————————————————————————— */
#sidebar {
    background-color: #181825;
    border-right: 1px solid #3e3e5c;
}

QToolButton#sidebarBtn {
    background-color: transparent;
    color: #9399b2;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    margin: 4px 6px;
    padding: 6px;
}
QToolButton#sidebarBtn:hover {
    background-color: #252536;
    color: #cdd6f4;
}
QToolButton#sidebarBtn:checked {
    background-color: #89b4fa22;
    color: #89b4fa;
    border-left: 3px solid #89b4fa;
}

/* ——— Left Panel ———————————————————————————————————— */
#leftPanel {
    background-color: #1e1e2e;
    border-right: 1px solid #3e3e5c;
}

/* ——— File Tree Toolbar ————————————————————————————— */
QPushButton#fileTreeToolBtn {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 6px;
    font-size: 12px;
    padding: 4px 8px;
}
QPushButton#fileTreeToolBtn:hover {
    background-color: #313145;
    border: 1px solid #89b4fa;
}
QPushButton#fileTreeToolBtn:pressed {
    background-color: #1e1e2e;
}

QLabel#fileTreePath {
    color: #9399b2;
    font-size: 10px;
    padding: 0px 8px 4px 8px;
}

/* ——— Right Workspace ——————————————————————————————— */
#workspace {
    background-color: #1e1e2e;
    border-left: 1px solid #3e3e5c;
}

QTabWidget::pane {
    border: none;
    background-color: #1e1e2e;
}
QTabBar::tab {
    background-color: #252536;
    color: #9399b2;
    padding: 8px 18px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: #313145;
    color: #cdd6f4;
    border-bottom: 2px solid #89b4fa;
}
QTabBar::tab:hover {
    background-color: #313145;
    color: #cdd6f4;
}

/* ——— Log Area —————————————————————————————————————— */
QTextEdit#logArea {
    background-color: #1e1e2e;
    border: none;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    line-height: 1.5;
}

/* ——— Document Editor ——————————————————————————————— */
#docEditorToolbar {
    background-color: #252536;
    border-bottom: 1px solid #3e3e5c;
}
#docEditorPath {
    color: #9399b2;
    font-size: 11px;
}
QPushButton#docEditorEditBtn {
    background-color: #313145;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    padding: 4px 14px;
    border-radius: 6px;
    font-size: 11px;
}
QPushButton#docEditorEditBtn:hover {
    background-color: #3e3e5c;
    border: 1px solid #89b4fa;
}
QPushButton#docEditorCancelBtn {
    background-color: #313145;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    padding: 4px 14px;
    border-radius: 6px;
    font-size: 11px;
}
QPushButton#docEditorCancelBtn:hover {
    background-color: #f38ba8;
    border: 1px solid #f38ba8;
    color: #1e1e2e;
}
QPushButton#docEditorSaveBtn {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: 1px solid #a6e3a1;
    padding: 4px 14px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#docEditorSaveBtn:hover {
    background-color: #b8ebaf;
}
QTextEdit#docEditor {
    background-color: #1e1e2e;
    border: none;
    padding: 12px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    line-height: 1.5;
}

/* ——— Activity Panel ———————————————————————————————— */
QListWidget#activityList {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 12px;
    outline: none;
}
QListWidget#activityList::item {
    padding: 8px 12px;
    border-radius: 8px;
    margin: 2px 8px;
    border-bottom: 1px solid #252536;
}
QListWidget#activityList::item:hover { background-color: #252536; }
QListWidget#activityList::item:selected {
    background-color: #89b4fa22;
    border-left: 3px solid #89b4fa;
    padding-left: 9px;
}
QTextEdit#activityDetail {
    background-color: #252536;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 12px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    color: #cdd6f4;
}

#panelHeader {
    color: #cdd6f4;
    font-size: 11px;
    font-weight: bold;
    padding: 12px 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ——— Buttons ——————————————————————————————————————— */
QPushButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover { background-color: #9ec1fb; }
QPushButton:pressed { background-color: #74a4f0; }
QPushButton:disabled {
    background-color: #313145;
    color: #9399b2;
}

QPushButton#newChatBtn {
    background-color: #89b4fa;
    font-weight: 600;
}
QPushButton#newChatBtn:hover { background-color: #9ec1fb; }
QPushButton#sendBtn {
    font-weight: bold;
}

QPushButton#stopBtn {
    background-color: #f38ba8;
    font-weight: 600;
    color: #1e1e2e;
}
QPushButton#stopBtn:hover {
    background-color: #f59fb6;
}

/* ——— Input Fields —————————————————————————————————— */
QLineEdit {
    background-color: #313145;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    selection-background-color: #89b4fa44;
}
QLineEdit:focus { border: 1px solid #89b4fa; }

QTextEdit {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    line-height: 1.5;
    selection-background-color: #89b4fa44;
}

QPlainTextEdit {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    line-height: 1.5;
    selection-background-color: #89b4fa44;
}

/* ——— Lists ————————————————————————————————————————— */
QListWidget {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 13px;
    outline: none;
}
QListWidget::item {
    padding: 10px 14px;
    border-radius: 8px;
    margin: 2px 8px;
}
QListWidget::item:hover { background-color: #252536; }
QListWidget::item:selected {
    background-color: #89b4fa22;
    color: #89b4fa;
    border-left: 3px solid #89b4fa;
    padding-left: 11px;
}
QListWidget::item:selected:!active {
    background-color: #89b4fa15;
}

/* ——— Tree View ————————————————————————————————————— */
QTreeView {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 13px;
    outline: none;
}
QTreeView::item {
    padding: 6px 10px;
    border-radius: 6px;
}
QTreeView::item:hover { background-color: #252536; }
QTreeView::item:selected {
    background-color: #89b4fa22;
    color: #89b4fa;
    border-left: 3px solid #89b4fa;
    padding-left: 7px;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings { image: none; }
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings { image: none; }

/* ——— Project Explorer —————————————————————————————— */
QTreeWidget#projectExplorer {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 12px;
    outline: none;
}
QTreeWidget#projectExplorer::item {
    padding: 6px 10px;
    border-radius: 6px;
}
QTreeWidget#projectExplorer::item:hover { background-color: #252536; }
QTreeWidget#projectExplorer::item:selected {
    background-color: #89b4fa22;
    color: #89b4fa;
    border-left: 3px solid #89b4fa;
    padding-left: 7px;
}
QTreeWidget#projectExplorer::branch:closed:has-children { image: none; }
QTreeWidget#projectExplorer::branch:open:has-children { image: none; }

/* ——— Chat Area ————————————————————————————————————— */
QTextEdit#chatArea {
    background-color: #1e1e2e;
    border: none;
    padding: 14px;
    font-size: 14px;
    line-height: 1.6;
}
QTextEdit#chatArea QScrollBar:vertical {
    background: #1e1e2e;
    width: 8px;
    margin: 0;
}
QTextEdit#chatArea QScrollBar::handle:vertical {
    background: #3e3e5c;
    border-radius: 4px;
    min-height: 20px;
}

/* ——— Input Widget —————————————————————————————————— */
QWidget#inputWidget {
    background-color: #252536;
    border-top: 1px solid #3e3e5c;
}

QLabel#modeLabel {
    color: #cdd6f4;
    font-weight: 600;
    font-size: 13px;
}
QLabel#sessionLabel {
    color: #9399b2;
    font-size: 12px;
}
QFrame#toolbarSeparator {
    color: #3e3e5c;
    max-height: 1px;
}

/* ——— Terminal —————————————————————————————————————— */
QPlainTextEdit#terminalOutput {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    line-height: 1.5;
}
QLabel#terminalPrompt {
    color: #a6e3a1;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    font-weight: bold;
}

/* ——— Scrollbars ———————————————————————————————————— */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3e3e5c66;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #3e3e5caa;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3e3e5c66;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #3e3e5caa;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ——— Code Blocks (HTML in QTextEdit) ——————————————— */
pre {
    background-color: #252536;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 14px;
    margin: 12px 0;
    overflow-x: auto;
}
code {
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    color: #cdd6f4;
}
table {
    border-collapse: collapse;
    margin: 10px 0;
    width: 100%;
}
th, td {
    border: 1px solid #3e3e5c;
    padding: 10px 14px;
    text-align: left;
}
th {
    background-color: #252536;
    font-weight: 600;
}

/* ——— Chat Message Bubbles —————————————————————————— */
/* user bubble: right-aligned, accent background */
.user-bubble {
    background-color: #89b4fa;
    color: #1e1e2e;
    border-radius: 12px;
    padding: 10px 14px;
    margin: 8px 0 8px 60px;
    display: inline-block;
    max-width: 70%;
}
/* AI bubble: left-aligned, card background */
.ai-bubble {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 12px;
    padding: 10px 14px;
    margin: 8px 60px 8px 0;
    display: inline-block;
    max-width: 70%;
}

/* ——— Splitter —————————————————————————————————————— */
QSplitter::handle {
    background-color: #3e3e5c;
}
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:horizontal { width: 1px; }

/* ——— Status Bar ———————————————————————————————————— */
QStatusBar {
    background-color: #181825;
    border-top: 1px solid #3e3e5c;
    color: #9399b2;
    padding: 4px 14px;
    font-size: 12px;
}
QStatusBar QLabel {
    color: #9399b2;
    font-size: 12px;
    padding: 0 6px;
}

/* ——— Label ————————————————————————————————————————— */
QLabel {
    color: #cdd6f4;
    font-size: 13px;
}

/* ——— Dialog ———————————————————————————————————————— */
QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

/* ——— ComboBox —————————————————————————————————————— */
QComboBox {
    background-color: #313145;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    min-height: 22px;
}
QComboBox:hover { border: 1px solid #89b4fa; }
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9399b2;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #252536;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    selection-background-color: #89b4fa22;
    selection-color: #89b4fa;
    outline: none;
    padding: 6px;
}

/* ——— Table ————————————————————————————————————————— */
QTableWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    gridline-color: #252536;
    border-radius: 8px;
}
QTableWidget::item { padding: 8px; }
QTableWidget::item:selected {
    background-color: #89b4fa22;
    color: #89b4fa;
}
QHeaderView::section {
    background-color: #252536;
    color: #cdd6f4;
    border: none;
    border-bottom: 1px solid #3e3e5c;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 12px;
}

/* ——— Progress Bar —————————————————————————————————— */
QProgressBar {
    background-color: #313145;
    border: none;
    border-radius: 4px;
    height: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 4px;
}

/* ——— Check Box ————————————————————————————————————— */
QCheckBox {
    color: #cdd6f4;
    font-size: 13px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #3e3e5c;
    border-radius: 4px;
    background-color: #252536;
}
QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

/* ——— Group Box ————————————————————————————————————— */
QGroupBox {
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    font-size: 13px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ——— Spin Box —————————————————————————————————————— */
QSpinBox, QDoubleSpinBox {
    background-color: #313145;
    color: #cdd6f4;
    border: 1px solid #3e3e5c;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #89b4fa; }
